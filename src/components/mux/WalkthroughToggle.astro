---
interface Props {
  id?: string;
  proseTitle?: string;
  codeTitle?: string;
  showCodeLabel?: string;
  showProseLabel?: string;
}

const {
  id = "anatomy-of-an-unconstrained-loop-vs-a-bounded-harness-step",
  proseTitle = "Anatomy of an Unconstrained Loop vs. a Bounded Harness Step",
  codeTitle = "Anatomy of an Unconstrained Diff vs. a Bounded Harness Step",
  showCodeLabel = "Show code example",
  showProseLabel = "Show prose summary",
} = Astro.props;
---

<section class="wt-section" data-wt-root>
  <div class="wt-header">
    <h3
      id={id}
      class="wt-heading"
      data-wt-heading
      data-prose-title={proseTitle}
      data-code-title={codeTitle}
    >
      {proseTitle}
    </h3>
    <button
      type="button"
      class="wt-toggle"
      aria-pressed="false"
      data-wt-toggle
      data-label-code={showCodeLabel}
      data-label-prose={showProseLabel}
    >
      <svg
        class="wt-icon"
        viewBox="0 0 16 16"
        width="13"
        height="13"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="5 4 1.5 8 5 12"></polyline>
        <polyline points="11 4 14.5 8 11 12"></polyline>
        <line x1="9.2" y1="2.5" x2="6.8" y2="13.5"></line>
      </svg>
      <span data-wt-label>{showCodeLabel}</span>
    </button>
  </div>

  <div data-wt-prose>
    <slot name="prose" />
  </div>

  <div data-wt-code hidden>
    <slot name="code" />
  </div>
</section>

<style>
  .wt-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .wt-heading {
    margin: 0 !important;
  }

  .wt-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgba(24, 24, 26, 0.16);
    background: #faf9f5;
    color: #5b6570;
    font: 500 0.75rem/1.2 var(--font-sans);
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition:
      color 140ms ease,
      border-color 140ms ease,
      background-color 140ms ease;
  }

  .wt-toggle:hover {
    color: #107599;
    border-color: rgba(16, 117, 153, 0.45);
    background: #ffffff;
  }

  .wt-toggle[aria-pressed="true"] {
    color: #107599;
    border-color: rgba(16, 117, 153, 0.5);
    background: rgba(16, 117, 153, 0.07);
  }

  .wt-icon {
    flex-shrink: 0;
  }

  :global([data-wt-prose][hidden]),
  :global([data-wt-code][hidden]) {
    display: none !important;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-wt-root]")) {
    if (root.dataset.wtBound === "true") continue;
    root.dataset.wtBound = "true";

    const btn = root.querySelector<HTMLButtonElement>("[data-wt-toggle]");
    const labelEl = root.querySelector<HTMLElement>("[data-wt-label]");
    const headingEl = root.querySelector<HTMLElement>("[data-wt-heading]");

    if (!btn) continue;

    btn.addEventListener("click", () => {
      const showingCode = btn.getAttribute("aria-pressed") !== "true";
      btn.setAttribute("aria-pressed", showingCode ? "true" : "false");

      for (const el of document.querySelectorAll<HTMLElement>(
        "[data-wt-prose]",
      )) {
        el.hidden = showingCode;
      }
      for (const el of document.querySelectorAll<HTMLElement>(
        "[data-wt-code]",
      )) {
        el.hidden = !showingCode;
      }

      if (labelEl) {
        labelEl.textContent = showingCode
          ? (btn.dataset.labelProse ?? "Show prose summary")
          : (btn.dataset.labelCode ?? "Show code example");
      }
      if (headingEl) {
        headingEl.textContent = showingCode
          ? (headingEl.dataset.codeTitle ?? headingEl.textContent)
          : (headingEl.dataset.proseTitle ?? headingEl.textContent);
      }
    });
  }
</script>
