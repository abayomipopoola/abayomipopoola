---
import "../../styles/mux-diagrams.css";

interface Props {
  id?: string;
  proseTitle?: string;
  codeTitle?: string;
  showCodeLabel?: string;
  showProseLabel?: string;
}

const {
  id = "anatomy-of-an-unconstrained-loop-vs-a-bounded-harness-step",
  proseTitle = "Anatomy of an Unconstrained Loop vs. a Bounded Harness Step",
  codeTitle = "Anatomy of an Unconstrained Diff vs. a Bounded Harness Step",
  showCodeLabel = "Show code example",
  showProseLabel = "Show prose summary",
} = Astro.props;
---

<section class="wt-section" data-wt-root>
  <div class="wt-header">
    <h3
      id={id}
      class="wt-heading"
      data-wt-heading
      data-prose-title={proseTitle}
      data-code-title={codeTitle}
    >
      {proseTitle}
    </h3>
    <button
      type="button"
      class="wt-toggle"
      aria-pressed="false"
      data-wt-toggle
      data-label-code={showCodeLabel}
      data-label-prose={showProseLabel}
    >
      <svg
        class="wt-icon"
        viewBox="0 0 16 16"
        width="13"
        height="13"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="5 4 1.5 8 5 12"></polyline>
        <polyline points="11 4 14.5 8 11 12"></polyline>
        <line x1="9.2" y1="2.5" x2="6.8" y2="13.5"></line>
      </svg>
      <span data-wt-label>{showCodeLabel}</span>
    </button>
  </div>

  <div data-wt-prose>
    <slot name="prose" />
  </div>

  <div data-wt-code hidden>
    <slot name="code" />
  </div>
</section>

<script is:inline>
  (() => {
    for (const root of document.querySelectorAll("[data-wt-root]")) {
      if (root.dataset.wtBound === "true") continue;
      root.dataset.wtBound = "true";

      const btn = root.querySelector("[data-wt-toggle]");
      const labelEl = root.querySelector("[data-wt-label]");
      const headingEl = root.querySelector("[data-wt-heading]");

      if (!btn) continue;

      btn.addEventListener("click", () => {
        const showingCode = btn.getAttribute("aria-pressed") !== "true";
        btn.setAttribute("aria-pressed", showingCode ? "true" : "false");

        for (const el of document.querySelectorAll("[data-wt-prose]")) {
          el.hidden = showingCode;
        }
        for (const el of document.querySelectorAll("[data-wt-code]")) {
          el.hidden = !showingCode;
        }

        if (labelEl) {
          labelEl.textContent = showingCode
            ? (btn.dataset.labelProse ?? "Show prose summary")
            : (btn.dataset.labelCode ?? "Show code example");
        }
        if (headingEl) {
          headingEl.textContent = showingCode
            ? (headingEl.dataset.codeTitle ?? headingEl.textContent)
            : (headingEl.dataset.proseTitle ?? headingEl.textContent);
        }
      });
    }
  })();
</script>
