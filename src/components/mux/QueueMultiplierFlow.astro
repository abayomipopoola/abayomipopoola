---
// Modelled on Principles of Product Development Flow Pt. 2:
// Left: The Queue Multiplier Effect (exponential curve at 80% -> 90% -> 95% -> 100% utilisation).
// Right: Cumulative Flow Diagram (CFD) showing a widening "In Review / Unverified WIP" band vs parallel flow.
---

<div class="ec-split">
  <div class="ec-panel">
    <p class="ec-panel-title fx-in" style="--d:0">
      The Queue Multiplier Effect
    </p>
    <svg
      class="ec-svg"
      viewBox="0 0 320 240"
      role="img"
      aria-label="Exponential curve showing Queue Size and Wait Time against Capacity Utilisation. At 80% utilisation the queue is manageable; at 90% it doubles; at 95% it doubles again; approaching 100% it shoots toward infinity."
    >
      <!-- Grid lines -->
      <g class="ec-grid" aria-hidden="true">
        <line x1="44" y1="64" x2="294" y2="64" />
        <line x1="44" y1="114" x2="294" y2="114" />
        <line x1="44" y1="154" x2="294" y2="154" />
      </g>

      <!-- Axes -->
      <line x1="44" y1="24" x2="44" y2="190" class="ec-axis-line" />
      <line x1="44" y1="190" x2="298" y2="190" class="ec-axis-line" />

      <text x="20" y="110" text-anchor="middle" class="ec-axis-sub">
        Queue
      </text>
      <text x="172" y="226" text-anchor="middle" class="ec-axis-title">
        Verification Capacity Utilisation
      </text>

      <!-- Exponential M/M/1 Queue Curve -->
      <path
        class="ec-curve fx-draw"
        data-c="coral"
        pathLength="1"
        style="--d:250;--dur:1.1s"
        d="M 52 184 C 110 180, 155 168, 182 154 C 210 138, 232 114, 248 64 C 256 42, 262 30, 266 24"
      />

      <!-- 80% marker -->
      <g class="fx-pop" style="--d:800">
        <line
          x1="182"
          y1="154"
          x2="182"
          y2="190"
          class="ec-Guide"
          data-c="teal"
        />
        <circle cx="182" cy="154" r="4" class="ec-dot" data-c="teal" />
        <text x="182" y="204" text-anchor="middle" class="ec-axis-sub">
          80%
        </text>
        <text x="168" y="146" text-anchor="end" class="ec-note-sub">
          1× queue
        </text>
      </g>

      <!-- 90% marker (doubles) -->
      <g class="fx-pop" style="--d:1100">
        <line
          x1="226"
          y1="114"
          x2="226"
          y2="190"
          class="ec-Guide"
          data-c="amber"
        />
        <circle cx="226" cy="114" r="4" class="ec-dot" data-c="amber" />
        <text x="226" y="204" text-anchor="middle" class="ec-axis-sub">
          90%
        </text>
        <text x="216" y="108" text-anchor="end" class="ec-note" data-c="amber">
          2× doubles
        </text>
      </g>

      <!-- 95% marker (doubles again) -->
      <g class="fx-pop" style="--d:1400">
        <line
          x1="248"
          y1="64"
          x2="248"
          y2="190"
          class="ec-Guide"
          data-c="coral"
        />
        <circle cx="248" cy="64" r="4.5" class="ec-dot" data-c="coral" />
        <text x="256" y="204" text-anchor="middle" class="ec-axis-sub">
          95%
        </text>
        <text x="238" y="56" text-anchor="end" class="ec-note" data-c="coral">
          4× doubles again
        </text>
      </g>

      <!-- 100% asymptote -->
      <line x1="274" y1="22" x2="274" y2="190" class="ec-Guide" data-c="grey" />
      <text x="288" y="204" text-anchor="middle" class="ec-axis-sub">
        100%
      </text>
    </svg>
  </div>

  <div class="ec-panel">
    <p class="ec-panel-title fx-in" style="--d:1650">
      Cumulative Flow: Widening WIP vs. Stable Flow
    </p>
    <svg
      class="ec-svg"
      viewBox="0 0 320 240"
      role="img"
      aria-label="Two Cumulative Flow Diagrams side by side. Left: Unconstrained Agent widens the middle In Review band as code arrives faster than senior engineers can safely verify it. Right: Governed Harness keeps arrival and departure lines parallel with a thin WIP band."
    >
      <!-- Left sub-CFD: Unconstrained (Widening WIP Band, cfd-seven.png style) -->
      <text x="88" y="26" text-anchor="middle" class="ec-axis-title">
        Unconstrained Loop
      </text>
      <line x1="28" y1="38" x2="28" y2="178" class="ec-axis-line" />
      <line x1="28" y1="178" x2="148" y2="178" class="ec-axis-line" />

      <!-- Widening WIP band between Arrival (steep) and Safe Departure (flat) -->
      <polygon
        class="ec-area fx-pop"
        data-c="coral"
        style="--d:1950"
        points="28,166 144,46 144,136 28,174"
      />
      <!-- Arrival line (code generated) -->
      <line
        x1="28"
        y1="166"
        x2="144"
        y2="46"
        class="ec-curve fx-draw"
        data-c="coral"
        pathLength="1"
        style="--d:1800;--dur:0.8s"
      />
      <!-- Departure line (safely merged) -->
      <line
        x1="28"
        y1="174"
        x2="144"
        y2="136"
        class="ec-curve fx-draw"
        data-c="amber"
        pathLength="1"
        style="--d:1900;--dur:0.8s"
      />
      <text
        x="104"
        y="104"
        text-anchor="middle"
        class="ec-note fx-in"
        data-c="coral"
        style="--d:2150"
      >
        Widening WIP
      </text>
      <text x="88" y="196" text-anchor="middle" class="ec-note-sub">
        Arrival &gt; safe review capacity
      </text>

      <!-- Right sub-CFD: Governed Harness (Parallel Flow, cfd-six.png style) -->
      <text x="242" y="26" text-anchor="middle" class="ec-axis-title">
        Governed Harness
      </text>
      <line x1="182" y1="38" x2="182" y2="178" class="ec-axis-line" />
      <line x1="182" y1="178" x2="302" y2="178" class="ec-axis-line" />

      <!-- Thin parallel WIP band -->
      <polygon
        class="ec-area fx-pop"
        data-c="teal"
        style="--d:2400"
        points="182,162 298,52 298,72 182,174"
      />
      <line
        x1="182"
        y1="162"
        x2="298"
        y2="52"
        class="ec-curve fx-draw"
        data-c="teal"
        pathLength="1"
        style="--d:2250;--dur:0.8s"
      />
      <line
        x1="182"
        y1="174"
        x2="298"
        y2="72"
        class="ec-curve fx-draw"
        data-c="green"
        pathLength="1"
        style="--d:2350;--dur:0.8s"
      />
      <text
        x="246"
        y="134"
        text-anchor="middle"
        class="ec-note fx-in"
        data-c="teal"
        style="--d:2550"
      >
        Parallel flow
      </text>
      <text x="242" y="196" text-anchor="middle" class="ec-note-sub">
        Thin WIP · short cycle time
      </text>

      <!-- Legend -->
      <rect
        x="38"
        y="214"
        width="10"
        height="10"
        rx="2"
        class="ec-area"
        data-c="coral"
      />
      <text x="54" y="223" class="ec-axis-sub">
        Band height = unverified diffs in review
      </text>
    </svg>
  </div>
</div>
